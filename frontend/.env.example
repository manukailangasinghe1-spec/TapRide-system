# TapRide frontend environment variables.
# Copy this file to .env.local for real backend work; never commit .env files.

# Mock data switch.
# "true"  -> always use the built-in mock data, even in a production build.
#            Use this for a production demo that has no backend.
# "false" -> always call the real FastAPI backend.
# unset   -> the owner dashboard uses mocks only under the dev server
#            (npm run dev); a production build with no value calls the real API.
VITE_USE_MOCK=true

# Base URL of the backend API. No trailing slash; endpoint paths already include
# /api/v1, so do not add a path suffix here.
VITE_API_BASE_URL=http://localhost:8000
