# TapRide frontend environment variables.
# Copy this file to .env.local for real backend work; never commit .env files.

# Mock data rule:
# - "true"  -> always use mock data, including in production builds
# - "false" -> always call the real FastAPI backend
# - unset   -> mock data during `npm run dev`, real API in a production build
VITE_USE_MOCK=true

# Base URL of the Sprint 3 backend. No trailing slash; endpoint paths include /api/v1.
VITE_API_BASE_URL=http://localhost:8000
