# TapRide frontend environment variables.
# Copy this file to .env.local for real backend work; never commit .env files.

# Set to "false" to call the real FastAPI backend instead of the mock service.
# Any other value (including unset) keeps the mocks on.
VITE_USE_MOCK=true

# Base URL of the Sprint 3 backend. No trailing slash; endpoint paths include /api/v1.
VITE_API_BASE_URL=http://localhost:8000
