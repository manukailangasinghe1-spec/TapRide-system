# --- TapRide frontend environment (copy to .env and adjust; .env is git-ignored) ---

# "true" (or unset)  -> dashboard uses the built-in mock data layer
# "false"            -> dashboard calls the real backend API
# Vite env vars are strings, so only the exact text "false" switches mocks off.
VITE_USE_MOCK=true

# Base URL of the TapRide backend API. Only used when VITE_USE_MOCK=false.
# Endpoint paths already include /api/v1, so do not add a path suffix here.
VITE_API_BASE_URL=http://localhost:8000
